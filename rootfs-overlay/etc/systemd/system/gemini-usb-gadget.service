[Unit]
Description=Mi 5 USB gadget (network + serial console)
After=sys-kernel-config.mount
Before=systemd-networkd.service

[Service]
# Not RemainAfterExit: udev starts this again whenever the USB device
# controller reappears (e.g. after using an OTG adapter), and the script
# re-binds the gadget. It exits immediately when already bound.
Type=oneshot
ExecStart=/usr/local/sbin/gemini-usb-gadget start

[Install]
WantedBy=multi-user.target
