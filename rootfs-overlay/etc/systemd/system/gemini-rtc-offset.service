[Unit]
Description=Restore the clock from the RTC and the saved offset
DefaultDependencies=no
After=local-fs.target
Before=time-set.target sysinit.target shutdown.target chrony.service systemd-timesyncd.service
Wants=time-set.target
Conflicts=shutdown.target
ConditionPathExists=/sys/class/rtc/rtc0/since_epoch

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/gemini-rtc-offset restore
ExecStop=/usr/local/sbin/gemini-rtc-offset save

[Install]
WantedBy=sysinit.target
