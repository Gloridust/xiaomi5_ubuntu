[Unit]
Description=Mi 5 first boot setup (grow rootfs, SSH host keys)
ConditionPathExists=!/var/lib/gemini/firstboot-done
DefaultDependencies=no
After=local-fs.target
Before=ssh.service ssh.socket sysinit.target
Wants=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/gemini-firstboot
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
