# Sway session for the Xiaomi Mi 5 (1080x1920, 5.15")
#   Volume up      show/hide the on-screen keyboard
#   Volume down    open another terminal
#   Power (short)  screen on/off      Power (3 s): power off
#   The screen turns off after SCREEN_TIMEOUT s (/etc/default/gemini, screen-timeout)
#   Swipe the top bar / tap a title to switch windows

set $term foot -c /usr/local/share/gemini/sway/foot.ini

output DSI-1 scale 2.5
output * bg #2c001e solid_color
input type:touch map_to_output DSI-1
seat * hide_cursor 2000
xwayland disable

default_border pixel 2
hide_edge_borders smart
workspace_layout tabbed
focus_follows_mouse no
font pango:DejaVu Sans 8

bar {
	position top
	status_command /usr/local/bin/gemini-bar-status
	font pango:DejaVu Sans Mono 8
	colors {
		background #2c001e
		statusline #ffffff
	}
}

bindsym XF86AudioRaiseVolume exec pkill -RTMIN wvkbd-mobintl
bindsym XF86AudioLowerVolume # the first terminal starts with the list of easy commands
exec $term bash -c 'phone-help; exec bash'
bindsym --locked XF86PowerOff exec /usr/local/bin/gemini-sway-screen toggle

exec wvkbd-mobintl -H 260 -L 180
exec $term
exec /usr/local/bin/gemini-sway-idle

include /etc/sway/config.d/*
