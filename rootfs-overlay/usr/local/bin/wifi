#!/bin/bash
# Simple WiFi tool for the Mi 5.
#
#   wifi                  pick a network from a list and connect (asks for password)
#   wifi list             show networks in range
#   wifi connect NAME [PASSWORD]
#   wifi status           what am I connected to? IP address?
#   wifi saved            networks remembered on this phone
#   wifi forget NAME      remove a remembered network
#   wifi on | off         switch the WiFi radio
#   wifi fix              reset WiFi when it stopped working
#   wifi hotspot [on|off] make the phone a WiFi hotspot, so you can SSH in
#                         from a laptop/phone when no other network works
set -u

[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"

CONF=/etc/default/gemini
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"
: "${HOTSPOT_SSID:=Mi5-Ubuntu}"
HOTSPOT_CON="gemini-hotspot"

b() { printf '\033[1m%s\033[0m\n' "$*"; }
ok() { printf '\033[1;32m%s\033[0m\n' "$*"; }
err() { printf '\033[1;31m%s\033[0m\n' "$*" >&2; }

ifname() { nmcli -t -f DEVICE,TYPE dev | awk -F: '$2=="wifi"{print $1; exit}'; }

need_dev() {
	dev=$(ifname)
	if [ -z "$dev" ]; then
		err "No WiFi device found. Try: wifi fix   (or reboot)"
		exit 1
	fi
}

hotspot_password() {
	if [ -z "${HOTSPOT_PASSWORD:-}" ]; then
		HOTSPOT_PASSWORD=$(tr -dc 'a-z0-9' < /dev/urandom | head -c 10)
		echo "HOTSPOT_PASSWORD=\"$HOTSPOT_PASSWORD\"" >> "$CONF"
	fi
	echo "$HOTSPOT_PASSWORD"
}

status() {
	need_dev
	local state con ip
	state=$(nmcli -t -f DEVICE,STATE dev | awk -F: -v d="$dev" '$1==d{print $2}')
	con=$(nmcli -t -f DEVICE,CONNECTION dev | awk -F: -v d="$dev" '$1==d{print $2}')
	ip=$(ip -4 -br addr show "$dev" 2>/dev/null | awk '{print $3}')
	b "WiFi ($dev): $state"
	[ -n "$con" ] && echo "  network: $con"
	[ -n "$ip" ] && echo "  address: $ip"
	if [ "$con" = "$HOTSPOT_CON" ]; then
		echo "  hotspot: $HOTSPOT_SSID   password: $(hotspot_password)"
		echo "  from a laptop on this hotspot:  ssh ${SUDO_USER:-ubuntu}@${ip%/*}"
	fi
	if nmcli -t networking connectivity check 2>/dev/null | grep -q full; then
		ok "  internet: OK"
	else
		echo "  internet: not reachable"
	fi
}

list() {
	need_dev
	nmcli dev wifi rescan ifname "$dev" 2>/dev/null; sleep 3
	nmcli -f IN-USE,SIGNAL,SECURITY,SSID dev wifi list ifname "$dev"
}

connect() {
	need_dev
	local ssid="$1" pass="${2:-}"
	nmcli con down "$HOTSPOT_CON" >/dev/null 2>&1
	if nmcli -t -f NAME con show | grep -qxF "$ssid" && [ -z "$pass" ]; then
		nmcli con up id "$ssid" ifname "$dev" && { ok "Connected to $ssid"; return 0; }
	fi
	if [ -z "$pass" ]; then
		sec=$(nmcli -t -f SSID,SECURITY dev wifi list ifname "$dev" | awk -F: -v s="$ssid" '$1==s{print $2; exit}')
		if [ -n "$sec" ] && [ "$sec" != "--" ]; then
			read -r -s -p "Password for $ssid: " pass; echo
		fi
	fi
	if [ -n "$pass" ]; then
		nmcli dev wifi connect "$ssid" password "$pass" ifname "$dev"
	else
		nmcli dev wifi connect "$ssid" ifname "$dev"
	fi || { err "Could not connect to $ssid (wrong password? out of range?)"; return 1; }
	ok "Connected to $ssid. The phone will reconnect to it automatically."
}

pick() {
	need_dev
	echo "Scanning..."
	nmcli dev wifi rescan ifname "$dev" 2>/dev/null; sleep 3
	mapfile -t nets < <(nmcli -t -f SSID,SIGNAL,SECURITY dev wifi list ifname "$dev" |
		awk -F: '$1!="" && !seen[$1]++')
	if [ ${#nets[@]} -eq 0 ]; then
		err "No networks found. Try: wifi fix"
		return 1
	fi
	local i=1
	for n in "${nets[@]}"; do
		IFS=: read -r s sig sec <<<"$n"
		printf '%2d) %-28s %3s%%  %s\n' "$i" "$s" "$sig" "${sec:-open}"
		i=$((i + 1))
	done
	read -r -p "Number of the network (Enter = cancel): " n
	[[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le ${#nets[@]} ] || return 0
	IFS=: read -r s _ <<<"${nets[$((n - 1))]}"
	connect "$s"
}

fix() {
	echo "Resetting WiFi..."
	nmcli radio wifi on
	rfkill unblock wifi 2>/dev/null
	modprobe -r ath10k_pci 2>/dev/null; sleep 2; modprobe ath10k_pci; sleep 5
	systemctl restart NetworkManager; sleep 8
	status
}

hotspot() {
	need_dev
	case "${1:-on}" in
	off)
		nmcli con down "$HOTSPOT_CON" >/dev/null 2>&1 && ok "Hotspot off"
		;;
	*)
		local pw
		pw=$(hotspot_password)
		nmcli con delete "$HOTSPOT_CON" >/dev/null 2>&1
		nmcli dev wifi hotspot ifname "$dev" con-name "$HOTSPOT_CON" ssid "$HOTSPOT_SSID" password "$pw" >/dev/null ||
			{ err "Could not start the hotspot"; return 1; }
		nmcli con modify "$HOTSPOT_CON" connection.autoconnect no
		ok "Hotspot on:  name $HOTSPOT_SSID   password $pw"
		echo "Join it from a laptop or phone, then:  ssh ${SUDO_USER:-ubuntu}@10.42.0.1"
		echo "Turn it off with:  wifi hotspot off"
		;;
	esac
}

case "${1:-}" in
"") pick ;;
list|scan) list ;;
connect) [ -n "${2:-}" ] || { err "usage: wifi connect NAME [PASSWORD]"; exit 1; }; connect "$2" "${3:-}" ;;
status|s) status ;;
saved) nmcli -f NAME,TYPE con show | awk 'NR==1 || $NF=="wifi"' ;;
forget) [ -n "${2:-}" ] || { err "usage: wifi forget NAME"; exit 1; }; nmcli con delete id "$2" ;;
on) nmcli radio wifi on && ok "WiFi on" ;;
off) nmcli radio wifi off && ok "WiFi off" ;;
fix|reset) fix ;;
hotspot) hotspot "${2:-on}" ;;
-h|--help|help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' ;;
*) err "unknown command '$1'"; sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
