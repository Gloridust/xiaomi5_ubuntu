#!/usr/bin/python3 -I
"""Print one reading from each sensor (needs root).

The Mi 5's sensors hang off the sensor DSP (SLPI); the kernel's qcom-smgr
driver exposes them as IIO devices that only deliver data through their
buffer, so plain `cat in_*_raw` doesn't work. This enables the buffer, reads
one sample and prints it in SI units.

  gemini-sensors          one reading of every sensor
  gemini-sensors -w       keep printing (Ctrl+C to stop)
"""
import glob
import os
import select
import struct
import sys
import time

UNITS = {"accel": "m/s²", "anglvel": "rad/s", "magn": "gauss",
         "pressure": "hPa", "proximity": "", "illuminance": "lux"}


def rd(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return None


def wr(path, value):
    with open(path, "w") as f:
        f.write(value)


class Sensor:
    def __init__(self, path):
        self.path = path
        self.name = rd(path + "/name") or os.path.basename(path)
        self.dev = "/dev/" + os.path.basename(path)
        chans = []
        for en in glob.glob(path + "/scan_elements/*_en"):
            base = en[:-3]
            chans.append((int(rd(base + "_index")), os.path.basename(base)[3:], rd(base + "_type"), en))
        chans.sort()
        self.chans = chans
        fmt, off = "<", 0
        for _, _, typ, _ in chans:  # e.g. le:s32/32>>0
            sign, sizes = typ.split(":")[1][0], typ.split(":")[1][1:].split(">>")[0]
            size = int(sizes.split("/")[1]) // 8
            pad = (-off) % size
            fmt += "x" * pad + {1: "b", 2: "h", 4: "i", 8: "q"}[size].__getattribute__(
                "lower" if sign == "s" else "upper")()
            off += pad + size
        largest = max((int(t.split("/")[1].split(">>")[0]) // 8 for _, _, t, _ in chans), default=1)
        self.fmt = fmt + "x" * ((-off) % largest)

    def start(self):
        for *_, en in self.chans:
            wr(en, "1")
        wr(self.path + "/buffer/length", "16")
        wr(self.path + "/buffer/enable", "1")
        self.fd = os.open(self.dev, os.O_RDONLY | os.O_NONBLOCK)

    def stop(self):
        os.close(self.fd)
        wr(self.path + "/buffer/enable", "0")

    def read(self, timeout=3):
        size = struct.calcsize(self.fmt)
        if not select.select([self.fd], [], [], timeout)[0]:
            return None
        data = os.read(self.fd, size * 16)
        if len(data) < size:
            return None
        values = struct.unpack(self.fmt, data[-size - len(data) % size:][:size])
        out = []
        for (_, chan, _, _), v in zip(self.chans, values):
            if chan == "timestamp":
                continue
            kind = chan.split("_")[0]
            scale = float(rd("%s/in_%s_scale" % (self.path, kind)) or 1)
            v *= scale  # qcom-smgr reports pressure in hPa, not IIO's kPa
            out.append("%s=%.3f%s" % (chan, v, UNITS.get(kind, "")))
        return " ".join(out)


def main():
    if os.geteuid() != 0:
        sys.exit("gemini-sensors: run it as root (sudo gemini-sensors)")
    sensors = [Sensor(p) for p in sorted(glob.glob("/sys/bus/iio/devices/iio:device*"))
               if (rd(p + "/name") or "").startswith("qcom-smgr")]
    if not sensors:
        sys.exit("gemini-sensors: no sensors (is the slpi remoteproc running?)")
    watch = "-w" in sys.argv[1:]
    for s in sensors:
        s.start()
    try:
        while True:
            for s in sensors:
                print("%-22s %s" % (s.name, s.read() or "no data"))
            if not watch:
                break
            print()
            time.sleep(1)
    except KeyboardInterrupt:
        pass
    finally:
        for s in sensors:
            s.stop()


if __name__ == "__main__":
    main()
