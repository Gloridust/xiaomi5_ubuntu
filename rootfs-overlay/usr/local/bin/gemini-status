#!/bin/bash
# Quick overview of the phone's hardware state.
b() { printf '\033[1m%-12s\033[0m %s\n' "$1" "$2"; }

model=$(tr -d '\0' < /proc/device-tree/model 2>/dev/null || echo unknown)
b "Device" "$model, kernel $(uname -r)"

for ps in /sys/class/power_supply/*; do
	[ -e "$ps/type" ] || continue
	t=$(cat "$ps/type")
	case "$t" in
	Battery)
		cap=$(cat "$ps/capacity" 2>/dev/null || echo "?")
		st=$(cat "$ps/status" 2>/dev/null || echo "?")
		uv=$(cat "$ps/voltage_now" 2>/dev/null || echo 0)
		b "Battery" "${cap}% ${st} ($(awk "BEGIN{printf \"%.2f\", $uv/1000000}") V)"
		;;
	USB|Mains)
		b "Charger" "$(basename "$ps"): online=$(cat "$ps/online" 2>/dev/null || echo ?)"
		;;
	esac
done

temps=""
for z in /sys/class/thermal/thermal_zone*; do
	t=$(cat "$z/temp" 2>/dev/null) || continue
	temps="$temps$(cat "$z/type")=$((t / 1000))°C "
done
b "Temps" "${temps:-n/a}"

cpu=""
for p in /sys/devices/system/cpu/cpufreq/policy*; do
	[ -e "$p/scaling_cur_freq" ] || continue
	cpu="${cpu}cpu$(cat "$p/related_cpus" | tr ' ' ','): $(( $(cat "$p/scaling_cur_freq") / 1000 ))/$(( $(cat "$p/scaling_max_freq") / 1000 )) MHz  "
done
b "CPU speed" "$(sed -n 's/^CPU_SPEED=//p' /etc/default/gemini 2>/dev/null | tail -1) ${cpu:-(scaling off)}"
b "Sleep" "auto after $(sed -n 's/^AUTO_SLEEP=//p' /etc/default/gemini 2>/dev/null | tail -1) min (0 = never), $(cat /sys/power/suspend_stats/success 2>/dev/null || echo 0) sleeps this boot"

if command -v nmcli >/dev/null; then
	b "WiFi" "$(nmcli -t -f DEVICE,TYPE,STATE,CONNECTION dev | awk -F: '$2=="wifi"{print $1": "$3" "$4}' | tr '\n' ' ')"
fi
b "IP" "$(ip -br -4 addr | awk '$1!="lo"{print $1"="$3}' | tr '\n' ' ')"
b "Bluetooth" "$(ls /sys/class/bluetooth 2>/dev/null | tr '\n' ' ')"
b "Sensors" "$(cat /sys/bus/iio/devices/iio:device*/name 2>/dev/null | sed 's/^qcom-smgr-//' | tr '\n' ' ')"

dsps=""
for rp in /sys/class/remoteproc/remoteproc*; do
	[ -e "$rp/name" ] || continue
	dsps="$dsps$(cat "$rp/name"):$(cat "$rp/state") "
done
b "DSPs" "${dsps:-none}"
if [ -e /dev/dri/renderD128 ]; then b "GPU" "Adreno 530 render node present"; else b "GPU" "no render node"; fi
fw=/lib/firmware/qcom/msm8996/gemini
b "Firmware" "$(ls "$fw" 2>/dev/null | tr '\n' ' ' || echo none) (run: sudo gemini-firmware-install)"
