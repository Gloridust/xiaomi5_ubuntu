#!/bin/bash
# Install or update Claude Code with Anthropic's official installer.
#   install-claude        install / update
#   claude                start it   (claude-tmux: keeps running if SSH drops)
set -euo pipefail
if [ "$(id -u)" -eq 0 ]; then
	echo "Run this as your normal user, without sudo:  install-claude"
	exit 1
fi
echo "Checking internet..."
if ! curl -fsS -m 15 -o /dev/null https://claude.ai; then
	echo "No internet connection. Connect first with:  wifi"
	exit 1
fi
curl -fsSL https://claude.ai/install.sh | bash
export PATH="$HOME/.local/bin:$PATH"
grep -qs 'local/bin' "$HOME/.bashrc" || echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.bashrc"
echo
claude --version
echo
echo "Done. Start Claude Code with:   claude"
echo "Inside tmux (survives SSH disconnects):   claude-tmux"
