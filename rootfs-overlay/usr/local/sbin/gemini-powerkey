#!/usr/bin/python3 -I
"""Screen on/off for the text console.

- Short press of the power key toggles the screen.
- The screen turns off after SCREEN_TIMEOUT seconds without input
  (set in /etc/default/gemini, 0 = never).
- While the screen is off the touchscreen is "grabbed" so taps on the dark
  screen don't type into the on-screen keyboard.
- Long press (3 s) powers off - handled by systemd-logind.
- Volume up / volume down / Home button act as arrow up / arrow down /
  Enter, so the text menu can be used with the buttons (KEY_REMAP=no in
  /etc/default/gemini turns this off).
- Keeps the on-screen keyboard's picture current (see Flusher).

Not used by the sway/phosh UIs, which manage the screen themselves.
"""
import glob
import os
import select
import subprocess
import sys
import time

import evdev
from evdev import ecodes

CONF = "/etc/default/gemini"


def read_conf():
    conf = {}
    try:
        with open(CONF) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    conf[k.strip()] = v.strip().strip('"')
    except OSError:
        pass
    return conf


def write(path, value):
    try:
        with open(path, "w") as f:
            f.write(value)
    except OSError:
        pass


class Screen:
    def __init__(self):
        self.on = True

    def set(self, on):
        if on == self.on:
            return
        self.on = on
        # fbdev blank turns the DSI panel off through DRM; bl_power cuts the backlight.
        for fb in glob.glob("/sys/class/graphics/fb*/blank"):
            write(fb, "0" if on else "1")
        for bl in glob.glob("/sys/class/backlight/*/bl_power"):
            write(bl, "0" if on else "4")
        if on:
            # Unblanking redraws the whole console over the on-screen
            # keyboard, which only repaints keys as they are touched.
            subprocess.run(["systemctl", "--no-block", "restart", "buffyboard.service"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


class Flusher:
    """Push the framebuffer to the panel.

    The Mi 5's JDI panel runs in DSI command mode: the display controller
    only sends a frame when something commits one. fbcon does that for the
    console text, but buffyboard draws straight into the mmap()ed
    framebuffer, which commits nothing - so after tapping "123" the keyboard
    switched layers but the screen kept showing letters until the console
    printed something. Writing a pixel through /dev/fb0 makes the kernel
    commit a frame (the whole screen, in command mode); this rewrites the
    bottom-right pixel with its own value.

    ~30 frames/s while the touchscreen is in use and for BURST s after,
    once a second otherwise, nothing while the screen is off.
    """
    FAST, SLOW, BURST = 1 / 30, 1.0, 0.6

    def __init__(self):
        self.fd = None
        self.last = 0.0
        self.burst_until = 0.0
        try:
            def num(name):
                with open("/sys/class/graphics/fb0/" + name) as f:
                    return [int(x) for x in f.read().split(",")]
            xres, yres = num("virtual_size")
            bpp, = num("bits_per_pixel")
            stride, = num("stride")
            self.size = bpp // 8
            self.offset = stride * (yres - 1) + (xres - 1) * self.size
            self.fd = os.open("/dev/fb0", os.O_RDWR | os.O_CLOEXEC)
        except (OSError, ValueError) as e:
            print("gemini-powerkey: framebuffer flush off: %s" % e, file=sys.stderr)

    def touched(self, now):
        self.burst_until = now + self.BURST

    def wait(self, now):
        """Seconds until the next flush is due."""
        if self.fd is None:
            return None
        interval = self.FAST if now < self.burst_until else self.SLOW
        return max(0.0, self.last + interval - now)

    def flush(self, now):
        self.last = now
        try:
            os.pwrite(self.fd, os.pread(self.fd, self.size, self.offset), self.offset)
        except OSError:
            pass


def open_devices():
    keys, touch, other = [], [], []
    for path in evdev.list_devices():
        try:
            d = evdev.InputDevice(path)
        except OSError:
            continue
        caps = d.capabilities()
        evkeys = caps.get(ecodes.EV_KEY, [])
        if ecodes.KEY_POWER in evkeys:
            keys.append(d)
        elif ecodes.EV_ABS in caps and ecodes.BTN_TOUCH in evkeys:
            touch.append(d)
        else:
            other.append(d)
    return keys, touch, other


REMAP = {ecodes.KEY_VOLUMEUP: ecodes.KEY_UP,
         ecodes.KEY_VOLUMEDOWN: ecodes.KEY_DOWN,
         ecodes.KEY_HOME: ecodes.KEY_ENTER}


def setup_remap(other):
    """Grab the button devices (only volume/home keys) and return a virtual
    keyboard that sends arrows/Enter instead, or None."""
    try:
        ui = evdev.UInput({ecodes.EV_KEY: list(REMAP.values())}, name="gemini-buttons")
    except Exception as e:  # no /dev/uinput
        print("gemini-powerkey: key remap off: %s" % e, file=sys.stderr)
        return None, []
    grabbed = []
    for d in other:
        keys = set(d.capabilities().get(ecodes.EV_KEY, []))
        if keys and keys <= set(REMAP):
            try:
                d.grab()
                grabbed.append(d)
            except OSError:
                pass
    return ui, grabbed


def main():
    conf = read_conf()
    timeout = int(conf.get("SCREEN_TIMEOUT", "120") or 0)
    screen = Screen()
    # the screen may have been left off by an earlier run: start from "on"
    screen.on = False
    screen.set(True)
    flusher = Flusher()
    keys, touch, other = open_devices()
    if not keys:
        print("gemini-powerkey: no power key found", file=sys.stderr)
    ui, buttons = (None, [])
    if conf.get("KEY_REMAP", "yes") != "no":
        ui, buttons = setup_remap(other)
    devices = {d.fd: d for d in keys + touch + other}
    grabbed = False
    last = time.monotonic()
    pressed_at = None
    waking = None  # key that woke the screen: don't also send it

    while True:
        wait = None
        if timeout and screen.on:
            wait = max(0.5, timeout - (time.monotonic() - last))
        if screen.on:
            fw = flusher.wait(time.monotonic())
            if fw is not None:
                wait = fw if wait is None else min(wait, fw)
        r, _, _ = select.select(list(devices), [], [], wait)
        now = time.monotonic()
        if not r and timeout and screen.on and now - last >= timeout:
            screen.set(False)
        for fd in r:
            dev = devices[fd]
            try:
                events = list(dev.read())
            except OSError:
                devices.pop(fd, None)
                continue
            for ev in events:
                if ev.type == ecodes.EV_KEY and ev.code == ecodes.KEY_POWER:
                    if ev.value == 1:
                        pressed_at = now
                    elif ev.value == 0 and pressed_at is not None:
                        if now - pressed_at < 2.0:  # short press
                            screen.set(not screen.on)
                        pressed_at = None
                    last = now
                elif ev.type == ecodes.EV_KEY and ev.code in REMAP:
                    if not screen.on:
                        if ev.value == 1:  # first press only wakes the screen
                            screen.set(True)
                            waking = ev.code
                    elif ui is not None and dev in buttons and waking != ev.code:
                        ui.write(ecodes.EV_KEY, REMAP[ev.code], ev.value)
                        ui.syn()
                    if ev.value == 0 and waking == ev.code:
                        waking = None
                    last = now
                elif ev.type in (ecodes.EV_KEY, ecodes.EV_ABS) and screen.on:
                    last = now
                    if dev in touch:
                        flusher.touched(now)
        if screen.on and flusher.wait(now) == 0.0:
            flusher.flush(now)
        # grab the touchscreen while dark so taps don't reach buffyboard
        want_grab = not screen.on
        if want_grab != grabbed:
            for d in touch:
                try:
                    d.grab() if want_grab else d.ungrab()
                except OSError:
                    pass
            grabbed = want_grab


if __name__ == "__main__":
    main()
