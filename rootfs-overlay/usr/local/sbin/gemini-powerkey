#!/usr/bin/python3 -I
"""Screen on/off for the text console.

- Short press of the power key toggles the screen.
- The screen turns off after SCREEN_TIMEOUT seconds without input
  (set in /etc/default/gemini, 0 = never).
- While the screen is off the touchscreen is "grabbed" so taps on the dark
  screen don't type into the on-screen keyboard.
- Long press (3 s) powers off - handled by systemd-logind.
- Volume up / volume down / Home button act as arrow up / arrow down /
  Enter, so the text menu can be used with the buttons (KEY_REMAP=no in
  /etc/default/gemini turns this off).

Not used by the sway/phosh UIs, which manage the screen themselves.
"""
import glob
import os
import select
import sys
import time

import evdev
from evdev import ecodes

CONF = "/etc/default/gemini"


def read_conf():
    conf = {}
    try:
        with open(CONF) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    conf[k.strip()] = v.strip().strip('"')
    except OSError:
        pass
    return conf


def write(path, value):
    try:
        with open(path, "w") as f:
            f.write(value)
    except OSError:
        pass


class Screen:
    def __init__(self):
        self.on = True

    def set(self, on):
        if on == self.on:
            return
        self.on = on
        # fbdev blank turns the DSI panel off through DRM; bl_power cuts the backlight.
        for fb in glob.glob("/sys/class/graphics/fb*/blank"):
            write(fb, "0" if on else "1")
        for bl in glob.glob("/sys/class/backlight/*/bl_power"):
            write(bl, "0" if on else "4")


def open_devices():
    keys, touch, other = [], [], []
    for path in evdev.list_devices():
        try:
            d = evdev.InputDevice(path)
        except OSError:
            continue
        caps = d.capabilities()
        evkeys = caps.get(ecodes.EV_KEY, [])
        if ecodes.KEY_POWER in evkeys:
            keys.append(d)
        elif ecodes.EV_ABS in caps and ecodes.BTN_TOUCH in evkeys:
            touch.append(d)
        else:
            other.append(d)
    return keys, touch, other


REMAP = {ecodes.KEY_VOLUMEUP: ecodes.KEY_UP,
         ecodes.KEY_VOLUMEDOWN: ecodes.KEY_DOWN,
         ecodes.KEY_HOME: ecodes.KEY_ENTER}


def setup_remap(other):
    """Grab the button devices (only volume/home keys) and return a virtual
    keyboard that sends arrows/Enter instead, or None."""
    try:
        ui = evdev.UInput({ecodes.EV_KEY: list(REMAP.values())}, name="gemini-buttons")
    except Exception as e:  # no /dev/uinput
        print("gemini-powerkey: key remap off: %s" % e, file=sys.stderr)
        return None, []
    grabbed = []
    for d in other:
        keys = set(d.capabilities().get(ecodes.EV_KEY, []))
        if keys and keys <= set(REMAP):
            try:
                d.grab()
                grabbed.append(d)
            except OSError:
                pass
    return ui, grabbed


def main():
    conf = read_conf()
    timeout = int(conf.get("SCREEN_TIMEOUT", "120") or 0)
    screen = Screen()
    keys, touch, other = open_devices()
    if not keys:
        print("gemini-powerkey: no power key found", file=sys.stderr)
    ui, buttons = (None, [])
    if conf.get("KEY_REMAP", "yes") != "no":
        ui, buttons = setup_remap(other)
    devices = {d.fd: d for d in keys + touch + other}
    grabbed = False
    last = time.monotonic()
    pressed_at = None
    waking = None  # key that woke the screen: don't also send it

    while True:
        wait = None
        if timeout and screen.on:
            wait = max(0.5, timeout - (time.monotonic() - last))
        r, _, _ = select.select(list(devices), [], [], wait)
        now = time.monotonic()
        if not r:
            if timeout and screen.on and now - last >= timeout:
                screen.set(False)
        for fd in r:
            dev = devices[fd]
            try:
                events = list(dev.read())
            except OSError:
                devices.pop(fd, None)
                continue
            for ev in events:
                if ev.type == ecodes.EV_KEY and ev.code == ecodes.KEY_POWER:
                    if ev.value == 1:
                        pressed_at = now
                    elif ev.value == 0 and pressed_at is not None:
                        if now - pressed_at < 2.0:  # short press
                            screen.set(not screen.on)
                        pressed_at = None
                    last = now
                elif ev.type == ecodes.EV_KEY and ev.code in REMAP:
                    if not screen.on:
                        if ev.value == 1:  # first press only wakes the screen
                            screen.set(True)
                            waking = ev.code
                    elif ui is not None and dev in buttons and waking != ev.code:
                        ui.write(ecodes.EV_KEY, REMAP[ev.code], ev.value)
                        ui.syn()
                    if ev.value == 0 and waking == ev.code:
                        waking = None
                    last = now
                elif ev.type in (ecodes.EV_KEY, ecodes.EV_ABS) and screen.on:
                    last = now
        # grab the touchscreen while dark so taps don't reach buffyboard
        want_grab = not screen.on
        if want_grab != grabbed:
            for d in touch:
                try:
                    d.grab() if want_grab else d.ungrab()
                except OSError:
                    pass
            grabbed = want_grab


if __name__ == "__main__":
    main()
