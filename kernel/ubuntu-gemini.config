# Config fragment merged on top of kernel/base.config
# (base.config = postmarketOS linux-postmarketos-qcom-msm8996 config)
#
# Goals: what Ubuntu 26.04 (systemd, AppArmor, snapd, netplan) expects, and
# the drivers needed to reach the root filesystem built in, so the initramfs
# stays small.

CONFIG_LOCALVERSION="-gemini"
# CONFIG_LOCALVERSION_AUTO is not set

# --- Boot-critical: storage, filesystems, early display --------------------
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_BLK_DEV_SD=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y

# Big readable console font for a 1080x1920 5.15" screen
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
CONFIG_DRM_FBDEV_EMULATION=y

# Firmware from Ubuntu's linux-firmware is zstd-compressed
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y

# --- Ubuntu userspace expectations -----------------------------------------
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_LSM="landlock,lockdown,yama,integrity,apparmor,bpf"
CONFIG_AUDIT=y

# snapd
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_BLK_DEV_LOOP=y

# systemd
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_UNIX=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_PSI=y
CONFIG_DMIID=y
CONFIG_KCMP=y
CONFIG_IPV6=y

# Server niceties: containers, VPN, firewall
CONFIG_VETH=m
CONFIG_BRIDGE=m
CONFIG_TUN=m
CONFIG_WIREGUARD=m
CONFIG_NF_TABLES=m
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_ZRAM=m
CONFIG_ZSWAP=y

# --- Device drivers --------------------------------------------------------
# WiFi: QCA6174 on PCIe
CONFIG_PCI=y
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_PHY_QCOM_QMP_PCIE_8996=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
# Bluetooth: QCA6174 over UART
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=m
# Display + GPU (Adreno 530) + panel
CONFIG_DRM=y
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_14NM_PHY=y
CONFIG_DRM_PANEL_JDI_R63452=m
CONFIG_BACKLIGHT_QCOM_WLED=y
# Touchscreen: Synaptics RMI4
CONFIG_RMI4_CORE=y
CONFIG_RMI4_I2C=y
CONFIG_RMI4_F11=y
CONFIG_RMI4_F12=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_TOUCHSCREEN=y
# Buttons, vibrator, LEDs, IR, NFC
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_INPUT_DRV260X_HAPTICS=m
CONFIG_LEDS_LP5562=m
CONFIG_LEDS_QCOM_LPG=m
CONFIG_IR_PWM_TX=m
CONFIG_NFC_NXP_NCI_I2C=m
# Battery + charger (msm8996-mainline patches)
CONFIG_CHARGER_QCOM_SMBCHG=y
CONFIG_BATTERY_QCOM_FG=y
# USB: dwc3 dual role, TUSB320L type-C, gadget networking + serial
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_EXTCON_USBC_TUSB320=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_RNDIS=y
# Audio: WCD9335 codec via ADSP
CONFIG_SND_SOC_MSM8996=m
CONFIG_SND_SOC_WCD9335=m
# Remote processors (modem, ADSP, sensors DSP) + their transport
CONFIG_QCOM_Q6V5_MSS=m
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QRTR_TUN=y
# Video decode/encode
CONFIG_VIDEO_QCOM_VENUS=m
# Crash logs survive reboot (/sys/fs/pstore)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_MAGIC_SYSRQ=y
# CPU frequency scaling: modules, so a hang can't stop the phone from booting.
# gemini-cpufreq.service loads them after boot and turns scaling down a step
# if the previous boot with it never finished (docs/HARDWARE.md, "CPU speed").
CONFIG_CPUFREQ_DT=m
CONFIG_ARM_QCOM_CPUFREQ_NVMEM=m
# Not on the phone: the RTC of QEMU's "virt" machine, so the boot test can
# wake from sleep with an RTC alarm
CONFIG_RTC_DRV_PL031=m
