From f560e88012b1e30dfd26e6ddd704f5836b9325b7 Mon Sep 17 00:00:00 2001
From: Ethan Zou <gloridust@gmail.com>
Date: Fri, 30 Oct 2026 23:42:55 +0800
Subject: [PATCH] arm64: dts: qcom: msm8996-xiaomi-gemini: reserve stock memory
 regions, match stock ramoops layout

The stock device tree reserves the OCIMEM log and the gap between the
GPU and venus regions; keep Linux out of them too. Drop the ftrace zone
from ramoops so its layout matches the stock kernel: TWRP can then show
the console log of a crashed boot.

The splash buffer at 0x83400000 is deliberately not described: the
bootloader loads the initramfs over it, so it can't be reserved (and a
simple-framebuffer on it fails to probe).
---
 .../boot/dts/qcom/msm8996-xiaomi-gemini.dts  | 23 ++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/msm8996-xiaomi-gemini.dts b/arch/arm64/boot/dts/qcom/msm8996-xiaomi-gemini.dts
index c22129e..01015d3 100644
--- a/arch/arm64/boot/dts/qcom/msm8996-xiaomi-gemini.dts
+++ b/arch/arm64/boot/dts/qcom/msm8996-xiaomi-gemini.dts
@@ -26,6 +26,29 @@
 		pinctrl-names = "default";
 		pinctrl-0 = <&divclk2_pin_a>;
 	};
+
+	/* Regions the stock (Android) device tree reserves and msm8996.dtsi does not */
+	reserved-memory {
+		/* gap between gpu_mem and venus_mem, inside Android's peripheral_region */
+		memory@92302000 {
+			reg = <0x0 0x92302000 0x0 0xfe000>;
+			no-map;
+		};
+
+		ocimem-log@b4000000 {
+			reg = <0x0 0xb4000000 0x0 0x100000>;
+			no-map;
+		};
+
+		/*
+		 * Same layout as the stock kernel (no ftrace zone), so the
+		 * console log of a crashed boot is readable from TWRP at
+		 * /sys/fs/pstore/console-ramoops.
+		 */
+		ramoops@92900000 {
+			ftrace-size = <0>;
+		};
+	};
 };
 
 &adsp_pil {
-- 
2.53.0
